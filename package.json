{
  "name": "gcc-genesis-settlement",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded deliverable settlement contract for GCC Genesis Experiment",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "policy:hash": "node scripts/hash-genesis-policy.js",
    "policy:verify": "node scripts/verify-genesis-policy.js",
    "tender:hash": "node scripts/hash-genesis-tender.js",
    "tender:verify": "node scripts/verify-genesis-tender.js",
    "mainnet:inspect-gcc": "node scripts/inspect-gcc-mainnet.js",
    "mainnet:plan-funding": "node scripts/plan-genesis-funding.js",
    "mainnet:prepare": "node scripts/prepare-genesis-mainnet.js",
    "verifier-a:create": "node scripts/create-genesis-verifier-a.js",
    "verifier-a:run": "node scripts/run-genesis-verifier-a.js",
    "mainnet:deploy-ui": "hardhat compile && node scripts/serve-genesis-mainnet-deployer.js",
    "mainnet:verify": "hardhat run --network bsc scripts/verify-genesis-mainnet.js",
    "mainnet:verify-local": "hardhat run --network bsc scripts/check-genesis-mainnet-bytecode.js",
    "mainnet:verifier-canary": "node scripts/check-genesis-verifier-canary.js",
    "mainnet:relayer:create": "node scripts/create-genesis-relayer.js",
    "mainnet:relayer:canary": "node scripts/check-genesis-settlement-relayer.js",
    "mainnet:relayer:run": "node scripts/run-genesis-relayer.js",
    "mainnet:verification-bundle": "hardhat compile && hardhat run scripts/export-genesis-verification-bundle.js",
    "mainnet:intake:dry-run": "node scripts/dry-run-genesis-issue.js",
    "mainnet:intake:run": "node scripts/run-genesis-autonomous.js",
    "intake:sandbox-canary": "node scripts/check-genesis-intake-sandbox.js",
    "mainnet:intake:synthetic-issue:create": "node scripts/create-genesis-synthetic-issue.js",
    "mainnet:public-discovery:verify": "node scripts/check-genesis-public-discovery.js",
    "mainnet:live-readiness": "node scripts/check-genesis-live-readiness.js",
    "mainnet:gg6-relayer:run": "node scripts/run-gg6-grant-relayer.js",
    "mainnet:gg6-deploy-ui": "hardhat compile && node scripts/serve-gg6-mainnet-deployer.js",
    "mainnet:gg6-verify": "hardhat run --network bsc scripts/verify-gg6-mainnet.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "6.1.2",
    "@openzeppelin/contracts": "5.6.1",
    "hardhat": "2.29.1"
  }
}
