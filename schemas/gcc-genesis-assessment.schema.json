{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.goldcondor.info/schemas/gcc-genesis-assessment.schema.json",
  "title": "GCC Genesis Assessment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_version",
    "tender_hash",
    "submission_id",
    "deliverable_hash",
    "reward_class",
    "gate_results",
    "architectural_analysis",
    "security_analysis",
    "provenance_evidence",
    "recipient_binding_evidence",
    "assessment_hash_input_manifest"
  ],
  "properties": {
    "assessment_version": {
      "type": "string",
      "const": "0.3-draft"
    },
    "tender_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "submission_id": {
      "type": "string",
      "minLength": 1
    },
    "deliverable_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "reward_class": {
      "type": "string",
      "enum": [
        "QUALIFIED_PROPOSAL",
        "FINALIST",
        "SELECTED_COMPONENT"
      ]
    },
    "gate_results": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "evidence"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "architectural_analysis": {
      "type": "object"
    },
    "security_analysis": {
      "type": "object"
    },
    "provenance_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "recipient_binding_evidence": {
      "type": "object",
      "required": [
        "recipient_address",
        "binding_method",
        "binding_evidence_hash"
      ],
      "properties": {
        "recipient_address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "binding_method": {
          "type": "string",
          "minLength": 1
        },
        "binding_evidence_hash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      }
    },
    "assessment_hash_input_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
